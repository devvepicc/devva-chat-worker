{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devva-chat",
  "main": "devva-chat-worker.js",
  "compatibility_date": "2026-10-29",
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "exports": {
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
